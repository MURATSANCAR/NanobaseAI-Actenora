<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.nanobase.actenora</groupId>
    <artifactId>actenora</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Actenora</name>
    <description>Actenora modular monolith monorepo (Java aggregator)</description>

    <modules>
        <module>packages/observability/java</module>
        <module>packages/test-support/java</module>
        <module>modules</module>
        <module>apps/platform-backend</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.4.5</spring-boot.version>
        <spring-modulith.version>1.3.5</spring-modulith.version>
        <archunit.version>1.4.0</archunit.version>
        <aws.sdk.version>2.31.16</aws.sdk.version>
        <junit.version>5.11.4</junit.version>
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>policy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>microsoft-connection</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>meeting</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>transcript</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>model-management</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>ai-processing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>meeting-intelligence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>approval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>template</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>delivery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>operations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nanobase.actenora</groupId>
                <artifactId>teams-integration-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>rabbitmq</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>2.9.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
