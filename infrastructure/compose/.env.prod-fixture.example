# Prod-like compose secrets — copy to .env.prod-fixture and adjust.
# Non-default values required; prod profile refuses *_change_me / actenora_local fragments.
# SPRING_PROFILES_ACTIVE=prod,prod-fixture,it enables JDBC+Rabbit with mock IdP (Wave 7).

ACTENORA_ENV=prod-fixture
SPRING_PROFILES_ACTIVE=prod,prod-fixture,it

# --- Strong fixture secrets (not for real production) ---
POSTGRES_PASSWORD=fixture_pg_7kQm9xL2pR4vN8wZ
RABBITMQ_PASSWORD=fixture_rmq_8nWp0yM3qS5wO9xA
OBJECT_STORAGE_ACCESS_KEY=fixture_minio_access
OBJECT_STORAGE_SECRET_KEY=fixture_minio_9oXq1zN4rT6yP0bC
ACTENORA_MICROSOFT_GRAPH_CLIENT_STATE=fixture-graph-client-state-7f3a9c2e
ACTENORA_DELIVERY_WEBHOOK_SECRET=fixture-delivery-webhook-4d8b1e6f
ACTENORA_PORTAL_LINK_SECRET=fixture-portal-hmac-2c5a8d3b

# --- Persistence / messaging (also set in application-prod-fixture.yml) ---
ACTENORA_PERSISTENCE_MODE=jdbc
ACTENORA_MESSAGING_MODE=jdbc-rabbit
ACTENORA_AUTH_MODE=mock
ACTENORA_PORTAL_AUTH_MODE=mock

# --- Portal mock IdP headers (operator-supplied; no built-in demo personas) ---
VITE_MOCK_ENTRA_OID=
VITE_MOCK_ENTRA_TID=
VITE_MOCK_EMAIL=
VITE_MOCK_DISPLAY_NAME=
VITE_MOCK_GLOBAL_ADMIN=false
VITE_API_BASE_URL=http://localhost:8080

# --- Ports (host) ---
PLATFORM_BACKEND_PORT=8080
WEB_PORTAL_PORT=3000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
REDIS_PORT=6379
OBJECT_STORAGE_PORT=9000
