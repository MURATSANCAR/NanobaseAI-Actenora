# portal.nanobase.ai Actenora stack — copy to server /etc/nanobaseai/actenora.env
# Non-default secrets required. Entra values from your app registration.

ACTENORA_ENV=portal-server
SPRING_PROFILES_ACTIVE=prod,prod-fixture,it

# --- Strong fixture secrets (rotate for real production) ---
POSTGRES_PASSWORD=CHANGE_ME_pg_secret
RABBITMQ_PASSWORD=CHANGE_ME_rmq_secret
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_minio_access
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_minio_secret
ACTENORA_MICROSOFT_GRAPH_CLIENT_STATE=CHANGE_ME_graph_client_state
ACTENORA_DELIVERY_WEBHOOK_SECRET=CHANGE_ME_delivery_webhook
ACTENORA_PORTAL_LINK_SECRET=CHANGE_ME_portal_hmac

# --- Entra MSAL (portal SPA + API resource) ---
ACTENORA_AUTH_MODE=entra
ACTENORA_PORTAL_AUTH_MODE=msal
ACTENORA_ENTRA_ISSUER_URI=https://login.microsoftonline.com/{tenant-id}/v2.0
ACTENORA_ENTRA_AUDIENCE=api://{client-id}
ACTENORA_CORS_ALLOWED_ORIGINS=https://portal.nanobase.ai

# --- Platform backend host bind (nginx upstream) ---
ACTENORA_PLATFORM_BACKEND_HOST_PORT=8088
PLATFORM_BACKEND_PORT=8080

# --- Modules (staging defaults) ---
ACTENORA_PERSISTENCE_MODE=jdbc
ACTENORA_MESSAGING_MODE=jdbc-rabbit
ACTENORA_MICROSOFT_GRAPH_ENABLED=false
ACTENORA_MICROSOFT_GRAPH_TRANSCRIPT_ATTRIBUTION_RECHECK_WINDOW=P30D
# NanobaseAI Intelligence — OpenAI-compatible llama-server (not mock; not ai-orchestrator).
# Start/restore: scripts/server/restore-meeting-35b-llm.sh
ACTENORA_AI_PROVIDER_KIND=nanobaseai
ACTENORA_AI_PROVIDER_BASE_URL=http://host.docker.internal:8010
ACTENORA_AI_PROVIDER_READ_TIMEOUT=1800s
ACTENORA_AI_PROVIDER_MAX_ATTEMPTS=5
ACTENORA_AI_PROVIDER_FAST_EXTRACTION_SERVED_MODEL_ID=nanobase-qwen36-35b-a3b-mtp
ACTENORA_AI_PROVIDER_FINAL_SERVED_MODEL_ID=nanobase-qwen36-35b-a3b-mtp
ACTENORA_AI_EVAL_EXPORT_ENABLED=false
ACTENORA_AI_EVAL_EXPORT_ROOT=/app/var/eval-artifacts
ACTENORA_AI_EVAL_EXPORT_HOST_ROOT=../../artifacts/eval/runtime
ACTENORA_AI_EVAL_EXPORT_RETENTION_DAYS=30
ACTENORA_AI_PIPELINE_MODE=legacy
ACTENORA_AI_FINALIZATION_MODE=editorial
ACTENORA_AI_FINALIZATION_PROMPT_RESOURCE=/aiprocessing/prompts/editorial-summary.v1.txt
ACTENORA_AI_FINALIZATION_PROMPT_VERSION=pv-meeting-editorial-summary-v1
ACTENORA_AI_FINALIZATION_SCHEMA=meeting.editorial-summary.v1
ACTENORA_AI_FINALIZATION_TASK_TYPE=FINAL_NOTE
ACTENORA_AI_FINALIZATION_MAX_OUTPUT_TOKENS=768
ACTENORA_AI_FINALIZATION_TIMEOUT_SECONDS=1800
ACTENORA_AI_FINALIZATION_FAILURE_MODE=deterministic
ACTENORA_AI_WORKER_ENABLED=true
ACTENORA_ALLOW_DEFAULT_SECRETS=false

# --- Delivery mail via Microsoft Graph Mail.Send (no Authenticated SMTP) ---
ACTENORA_DELIVERY_MAIL_PROVIDER=microsoft-graph
ACTENORA_DELIVERY_GRAPH_SENDER=muratsancar@nanobase.ai
ACTENORA_DELIVERY_MAIL_FROM=muratsancar@nanobase.ai
ACTENORA_DELIVERY_MAIL_FROM_DISPLAY_NAME=NanobaseAI EasyMeeting
ACTENORA_DRAFT_MINUTES_READY_ADDITIONAL_RECIPIENTS=muratsancar@nanobase.ai
# Spring mail health only — actual delivery uses Graph
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
