# Actenora PRODUCTION env — copy to a secured path and fill in.
#   cp infrastructure/compose/.env.prod.example /etc/nanobaseai/actenora.prod.env
#   chmod 600 /etc/nanobaseai/actenora.prod.env
# Used by docker-compose.prod.yml. Values marked (REQUIRED) abort boot if empty.

# ============================ profile ========================================
SPRING_PROFILES_ACTIVE=prod
ACTENORA_ENV=production

# ============================ datastores =====================================
POSTGRES_DB=actenora
POSTGRES_USER=actenora
POSTGRES_PASSWORD=            # (REQUIRED) strong secret; not *_change_me
RABBITMQ_USER=actenora
RABBITMQ_PASSWORD=            # (REQUIRED)
RABBITMQ_VHOST=/
REDIS_PASSWORD=              # optional
OBJECT_STORAGE_ACCESS_KEY=   # (REQUIRED) MinIO root user
OBJECT_STORAGE_SECRET_KEY=   # (REQUIRED) MinIO root password
OBJECT_STORAGE_BUCKET=actenora

# ============================ auth / Entra (backend) =========================
ACTENORA_AUTH_MODE=entra
ACTENORA_PORTAL_AUTH_MODE=msal
ACTENORA_ENTRA_ISSUER_URI=      # (REQUIRED) e.g. https://login.microsoftonline.com/<tid>/v2.0
ACTENORA_ENTRA_AUDIENCE=        # (REQUIRED) API app registration audience / client id
ACTENORA_CORS_ALLOWED_ORIGINS=  # (REQUIRED) e.g. https://portal.nanobase.ai

# ============================ portal (Vite build args) =======================
# NOTE: these are baked at IMAGE BUILD time — rebuild the web-portal image after changing.
VITE_API_BASE_URL=             # (REQUIRED) public backend URL, e.g. https://portal.nanobase.ai/api
VITE_PORTAL_AUTH_MODE=msal
VITE_ENTRA_CLIENT_ID=          # (REQUIRED) SPA app registration client id
VITE_ENTRA_TENANT_ID=          # (REQUIRED)
VITE_ENTRA_API_SCOPE=          # (REQUIRED) e.g. api://<api-client-id>/access_as_user

# ============================ shared secrets =================================
ACTENORA_PORTAL_LINK_SECRET=            # (REQUIRED) HMAC secret for signed portal links
ACTENORA_DELIVERY_WEBHOOK_SECRET=       # (REQUIRED) delivery provider webhook secret
ACTENORA_DELIVERY_PORTAL_LINK_BASE_URL= # (REQUIRED) e.g. https://portal.nanobase.ai/easymeeting

# ============================ Microsoft Graph ================================
ACTENORA_MICROSOFT_GRAPH_ENABLED=true
ACTENORA_MICROSOFT_GRAPH_AUTH_MODE=CERTIFICATE   # CERTIFICATE (prod) | CLIENT_SECRET
ACTENORA_MICROSOFT_GRAPH_TENANT_ID=     # (REQUIRED)
ACTENORA_MICROSOFT_GRAPH_CLIENT_ID=     # (REQUIRED)
# For CLIENT_SECRET mode set this and leave the cert paths default:
ACTENORA_MICROSOFT_GRAPH_CLIENT_SECRET=
# For CERTIFICATE mode: put cert.pem + key.pem in the dir below (mounted read-only).
ACTENORA_GRAPH_SECRETS_HOST_DIR=./secrets/graph
ACTENORA_MICROSOFT_GRAPH_CERTIFICATE_PEM_PATH=/run/secrets/graph/cert.pem
ACTENORA_MICROSOFT_GRAPH_PRIVATE_KEY_PEM_PATH=/run/secrets/graph/key.pem
ACTENORA_MICROSOFT_GRAPH_CLIENT_STATE=  # (REQUIRED) webhook validation secret
ACTENORA_MICROSOFT_GRAPH_DEFAULT_MAILBOX_USER_ID=

# ============================ mail delivery (Graph Mail.Send) ================
ACTENORA_DELIVERY_MAIL_PROVIDER=microsoft-graph
ACTENORA_DELIVERY_GRAPH_SENDER=         # (REQUIRED) sending mailbox UPN/OID
ACTENORA_DELIVERY_MAIL_FROM=            # (REQUIRED) From address
ACTENORA_DELIVERY_MAIL_FROM_DISPLAY_NAME=NanobaseAI EasyMeeting
# Optional BCC on every draft-ready notice (empty = none):
ACTENORA_DELIVERY_DRAFT_MINUTES_READY_ADDITIONAL_RECIPIENTS=

# ============================ LLM ============================================
# Default: external LLM on the host at :8010 (llama-server / vLLM).
# For --profile gpu (in-compose vLLM) set BASE_URL=http://vllm:8000 and fill VLLM_* below.
ACTENORA_AI_PROVIDER_KIND=nanobaseai
ACTENORA_AI_PROVIDER_BASE_URL=http://host.docker.internal:8010
ACTENORA_AI_PROVIDER_FAST_EXTRACTION_SERVED_MODEL_ID=nanobase-qwen36-35b-a3b-mtp
ACTENORA_AI_PROVIDER_FINAL_SERVED_MODEL_ID=nanobase-qwen36-35b-a3b-mtp
ACTENORA_AI_PIPELINE_MODE=legacy       # legacy (proven on 35B) | staged
ACTENORA_AI_FINALIZATION_MODE=editorial

# ============================ embeddings =====================================
ACTENORA_KNOWLEDGE_EMBEDDING_MODE=openai-compatible
ACTENORA_KNOWLEDGE_EMBEDDING_BASE_URL=  # (REQUIRED) embedding endpoint
ACTENORA_KNOWLEDGE_EMBEDDING_MODEL_ID=  # (REQUIRED)
ACTENORA_KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
ACTENORA_KNOWLEDGE_EMBEDDING_API_KEY=

# ============================ host ports (loopback only) =====================
ACTENORA_PLATFORM_BACKEND_HOST_PORT=8088
WEB_PORTAL_HOST_PORT=3000

# ============================ vLLM (only with --profile gpu) =================
# VLLM_IMAGE=vllm/vllm-openai:latest
# VLLM_MODEL=                 # (REQUIRED for gpu profile) HF id or /models/... path
# VLLM_MODELS_HOST_DIR=./models
# VLLM_MAX_MODEL_LEN=16384
# VLLM_GPU_COUNT=1
# HUGGING_FACE_HUB_TOKEN=
