{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting.global-composition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "meetingFrame": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "text", "evidenceSegmentIds", "confidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "evidenceSegmentIds": {
          "type": "array",
          "items": { "type": ["string", "integer"] }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "evidenceSegmentIds", "confidence"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["DECISION", "ACTION", "COMMITMENT", "RISK", "OPEN_QUESTION", "IMPORTANT_FACT", "PROPOSAL"]
          },
          "text": { "type": "string", "minLength": 1 },
          "ownerCandidate": { "type": ["string", "null"] },
          "dueDateText": { "type": ["string", "null"] },
          "dueDateNormalized": { "type": ["string", "null"] },
          "evidenceSegmentIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": ["string", "integer"] }
          },
          "source": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
