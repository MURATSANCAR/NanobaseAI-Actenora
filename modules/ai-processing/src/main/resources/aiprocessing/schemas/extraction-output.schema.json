{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actenora.nanobase.ai/schemas/extraction-output.v1.json",
  "title": "MeetingChunkExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topics",
    "decisions",
    "actionItems",
    "risks",
    "openQuestions",
    "commitments",
    "qualityFlags",
    "evidenceSegmentIds",
    "confidence"
  ],
  "properties": {
    "topics": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedText" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedText" }
    },
    "actionItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionItem" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedText" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedText" }
    },
    "commitments": {
      "type": "array",
      "items": { "$ref": "#/$defs/commitment" }
    },
    "qualityFlags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidenceSegmentIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "evidencedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidenceSegmentIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidenceSegmentIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidenceSegmentIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "owner": { "type": ["string", "null"] },
        "dueDate": { "type": ["string", "null"] },
        "evidenceSegmentIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidenceSegmentIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "owner": { "type": ["string", "null"] },
        "evidenceSegmentIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
