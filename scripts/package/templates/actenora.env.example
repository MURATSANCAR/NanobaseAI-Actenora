# EasyMeeting (Actenora) — CUSTOMER environment. Copy to actenora.env and fill in.
#   cp actenora.env.example actenora.env && chmod 600 actenora.env
# Used by compose/docker-compose.customer.yml via ./install.sh
#
# FORMAT RULES (docker --env-file):
#   * KEY=VALUE, one per line. Comments only on their OWN line (no inline "# ...").
#   * Do NOT quote values; quotes are taken literally. Spaces in a value are fine.
#   * Items noted "(REQUIRED)" abort startup if empty.

# ============================ images =========================================
# Offline bundle: leave REGISTRY empty (images come from `docker load`).
# Registry pull:  set REGISTRY to your prefix WITH trailing slash, then use --pull.
ACTENORA_IMAGE_REGISTRY=
# Tag is appended automatically by build-bundle.sh; match the shipped tar.
ACTENORA_IMAGE_TAG=latest

# ============================ profile ========================================
SPRING_PROFILES_ACTIVE=prod
ACTENORA_ENV=production

# ============================ datastores (in-bundle) =========================
POSTGRES_DB=actenora
POSTGRES_USER=actenora
# (REQUIRED) strong secret; must not contain change_me / actenora_local
POSTGRES_PASSWORD=
RABBITMQ_USER=actenora
# (REQUIRED)
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
# (REQUIRED) MinIO root user
OBJECT_STORAGE_ACCESS_KEY=
# (REQUIRED) MinIO root password
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=actenora

# ============================ auth / Entra (backend) =========================
ACTENORA_AUTH_MODE=entra
ACTENORA_PORTAL_AUTH_MODE=msal
# (REQUIRED) e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
ACTENORA_ENTRA_ISSUER_URI=
# (REQUIRED) API app registration audience / client id
ACTENORA_ENTRA_AUDIENCE=
# (REQUIRED) e.g. https://meetings.customer.example
ACTENORA_CORS_ALLOWED_ORIGINS=

# ============================ portal (Vite build args) =======================
# NOTE: baked into the web-portal IMAGE at build time. Pass --env-file <this file>
# to build-bundle.sh so these are compiled in. Changing them means a rebuild.
# (REQUIRED) public backend URL, e.g. https://meetings.customer.example/api
VITE_API_BASE_URL=
VITE_PORTAL_AUTH_MODE=msal
# (REQUIRED) SPA app registration client id
VITE_ENTRA_CLIENT_ID=
# (REQUIRED)
VITE_ENTRA_TENANT_ID=
# (REQUIRED) e.g. api://<api-client-id>/access_as_user
VITE_ENTRA_API_SCOPE=

# ============================ shared secrets =================================
# (REQUIRED) HMAC secret for signed portal links
ACTENORA_PORTAL_LINK_SECRET=
# (REQUIRED) delivery provider webhook secret
ACTENORA_DELIVERY_WEBHOOK_SECRET=
# (REQUIRED) e.g. https://meetings.customer.example/easymeeting
ACTENORA_DELIVERY_PORTAL_LINK_BASE_URL=

# ============================ Microsoft Graph ================================
ACTENORA_MICROSOFT_GRAPH_ENABLED=true
# CERTIFICATE (prod) | CLIENT_SECRET
ACTENORA_MICROSOFT_GRAPH_AUTH_MODE=CERTIFICATE
# (REQUIRED)
ACTENORA_MICROSOFT_GRAPH_TENANT_ID=
# (REQUIRED)
ACTENORA_MICROSOFT_GRAPH_CLIENT_ID=
# For CLIENT_SECRET mode set this and leave the cert paths default:
ACTENORA_MICROSOFT_GRAPH_CLIENT_SECRET=
# For CERTIFICATE mode: put cert.pem + key.pem in the dir below (mounted read-only).
# Path is relative to the compose/ directory (so compose/secrets/graph by default).
ACTENORA_GRAPH_SECRETS_HOST_DIR=./secrets/graph
ACTENORA_MICROSOFT_GRAPH_CERTIFICATE_PEM_PATH=/run/secrets/graph/cert.pem
ACTENORA_MICROSOFT_GRAPH_PRIVATE_KEY_PEM_PATH=/run/secrets/graph/key.pem
# (REQUIRED) webhook validation secret
ACTENORA_MICROSOFT_GRAPH_CLIENT_STATE=
ACTENORA_MICROSOFT_GRAPH_DEFAULT_MAILBOX_USER_ID=

# ============================ mail delivery (Graph Mail.Send) ================
ACTENORA_DELIVERY_MAIL_PROVIDER=microsoft-graph
# (REQUIRED) sending mailbox UPN/OID
ACTENORA_DELIVERY_GRAPH_SENDER=
# (REQUIRED) From address
ACTENORA_DELIVERY_MAIL_FROM=
ACTENORA_DELIVERY_MAIL_FROM_DISPLAY_NAME=NanobaseAI EasyMeeting
ACTENORA_DELIVERY_DRAFT_MINUTES_READY_ADDITIONAL_RECIPIENTS=

# ============================ LLM (EXTERNAL — not in bundle) =================
# Point this at the customer's OpenAI-compatible endpoint (llama-server / vLLM).
# For the opt-in in-compose GPU LLM (--profile gpu) use http://vllm:8000.
ACTENORA_AI_PROVIDER_KIND=nanobaseai
# (REQUIRED) e.g. http://host.docker.internal:8010  or  http://vllm:8000
ACTENORA_AI_PROVIDER_BASE_URL=http://host.docker.internal:8010
ACTENORA_AI_PROVIDER_API_KEY=
ACTENORA_AI_PROVIDER_FAST_EXTRACTION_SERVED_MODEL_ID=nanobase-qwen36-35b-a3b-mtp
ACTENORA_AI_PROVIDER_FINAL_SERVED_MODEL_ID=nanobase-qwen36-35b-a3b-mtp
ACTENORA_AI_PIPELINE_MODE=legacy
ACTENORA_AI_FINALIZATION_MODE=editorial

# ============================ embeddings (EXTERNAL — not in bundle) ==========
ACTENORA_KNOWLEDGE_EMBEDDING_MODE=openai-compatible
# (REQUIRED) embedding endpoint (OpenAI-compatible /v1/embeddings)
ACTENORA_KNOWLEDGE_EMBEDDING_BASE_URL=
# (REQUIRED)
ACTENORA_KNOWLEDGE_EMBEDDING_MODEL_ID=
ACTENORA_KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
ACTENORA_KNOWLEDGE_EMBEDDING_API_KEY=

# ============================ host ports (loopback only) =====================
ACTENORA_PLATFORM_BACKEND_HOST_PORT=8088
WEB_PORTAL_HOST_PORT=3000
TEAMS_APP_HOST_PORT=3978

# ============================ vLLM (only with --profile gpu) =================
# VLLM_IMAGE=vllm/vllm-openai:latest
# VLLM_MODEL=
# VLLM_MODELS_HOST_DIR=./models
# VLLM_MAX_MODEL_LEN=16384
# VLLM_GPU_COUNT=1
# HUGGING_FACE_HUB_TOKEN=
