#!/usr/bin/env bash
# FAZ 27 — secret leak scan (gitleaks when available; heuristic fallback otherwise).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
ensure_path_tools

REPORT_DIR="${REPO_ROOT}/artifacts/security"
mkdir -p "${REPORT_DIR}"
REPORT="${REPORT_DIR}/secret-scan.txt"

fail_leak() {
  local msg="$1"
  echo "SECRET_SCAN_FAIL: ${msg}" | tee -a "${REPORT}"
  exit 1
}

: >"${REPORT}"
log "Secret scan starting → ${REPORT}"

if command -v gitleaks >/dev/null 2>&1; then
  log "Using gitleaks"
  gitleaks detect --source "${REPO_ROOT}" --no-git --report-path "${REPORT_DIR}/gitleaks.json" \
    --report-format json 2>&1 | tee -a "${REPORT}" || fail_leak "gitleaks reported findings"
  echo "gitleaks: clean" >>"${REPORT}"
else
  log "gitleaks not installed — running heuristic scan"
  # High-confidence patterns that should never be committed
  set +e
  MATCHES="$(rg -n --hidden --glob '!.git/**' --glob '!artifacts/**' --glob '!**/node_modules/**' --glob '!**/.venv/**' \
      -e '-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----' \
      -e 'AKIA[0-9A-Z]{16}' \
      -e 'sk-live-[A-Za-z0-9]{20,}' \
      -e 'ghp_[A-Za-z0-9]{36}' \
      "${REPO_ROOT}" 2>/dev/null)"
  RG_STATUS=$?
  set -e
  if [[ "${RG_STATUS}" -eq 0 && -n "${MATCHES}" ]]; then
    echo "${MATCHES}" | tee -a "${REPORT}"
    fail_leak "heuristic patterns matched committed secrets"
  fi
  echo "heuristic: clean" >>"${REPORT}"
fi

# Fixture for CI assertion that the scanner itself is wired
echo "secret-scan:ok" >>"${REPORT}"
log "Secret scan passed"
