# Actenora local development — copy to .env and adjust.
# Never commit real secrets.
# Default credentials are for ACTENORA_ENV=local / SPRING_PROFILES_ACTIVE=local ONLY.
# Production (SPRING_PROFILES_ACTIVE=prod) refuses *_change_me / actenora_local secrets.

# --- Runtime ---
ACTENORA_ENV=local
LOG_LEVEL=INFO

# --- Auth ---
# headers = real Entra operator identity via X-Actenora-* | entra+msal = SPA Microsoft login
ACTENORA_AUTH_MODE=headers
ACTENORA_PORTAL_AUTH_MODE=headers
# Required when ACTENORA_AUTH_MODE=entra / SPRING_PROFILES_ACTIVE=prod
# ACTENORA_ENTRA_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
# ACTENORA_ENTRA_AUDIENCE=api://<app-client-id>
# ACTENORA_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ACTENORA_ENTRA_ISSUER_URI=
ACTENORA_ENTRA_AUDIENCE=
ACTENORA_CORS_ALLOWED_ORIGINS=

# --- Platform backend (Java) ---
PLATFORM_BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Web portal (Node) ---
WEB_PORTAL_PORT=3000
# Portal talks only to platform-backend (no in-memory demo API)
VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:8080
# headers = X-Actenora-* identity headers | msal = Microsoft Entra redirect + Bearer token
VITE_PORTAL_AUTH_MODE=headers
# Required when VITE_PORTAL_AUTH_MODE=msal (also put these in apps/web-portal/.env.local for Vite)
# VITE_ENTRA_CLIENT_ID=<spa-app-client-id>
# VITE_ENTRA_TENANT_ID=<directory-tenant-id>
# VITE_ENTRA_API_SCOPE=api://<app-client-id>/access_as_user
# Entra checklist: SPA redirect http://127.0.0.1:3000 + Expose API scope access_as_user + grant SPA that scope
# Required when VITE_PORTAL_AUTH_MODE=headers — REAL Entra user in your directory
# (object id + work email + display name). Scripts fail closed if empty. No canned personas.
VITE_IDENTITY_ENTRA_OID=
VITE_IDENTITY_ENTRA_TID=
VITE_IDENTITY_EMAIL=
VITE_IDENTITY_DISPLAY_NAME=
VITE_IDENTITY_GLOBAL_ADMIN=false
# NanobaseAI family top bar (production: portal.nanobase.ai — not nanobasea.ai)
# VITE_NANOBI_QA_URL=https://qa.nanobase.ai
# VITE_NANOBI_BI_URL=https://bi.nanobase.ai
# VITE_NANOBI_ACTENORA_URL=https://portal.nanobase.ai
# VITE_NANOBI_CURRENT_PRODUCT=actenora
# Production deploy (make deploy-portal / make deploy-portal-full)
# ACTENORA_PORTAL_SSH_HOST=nanobase
# ACTENORA_PORTAL_INSTALL_DIR=/data/nanobaseai-mobile/portal/dist/actenora
# ACTENORA_PORTAL_BASE=/actenora/
# ACTENORA_PORTAL_PUBLIC_URL=https://portal.nanobase.ai/actenora/
# NANOBASE_MOBILE_QA_ROOT=/data/nanobaseai/mobile-qa
# SKIP_QA_PORTAL_DEPLOY=0
# SKIP_PORTAL_E2E=1

# --- Teams meeting app (Node) ---
TEAMS_APP_PORT=3978

# --- Teams integration service (FAZ 21, separately scalable) ---
TEAMS_INTEGRATION_PORT=8085
# CERTIFICATE = production; CLIENT_SECRET = local/test only
MICROSOFT_GRAPH_AUTH_MODE=CLIENT_SECRET
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CERTIFICATE_PEM_PATH=
MICROSOFT_PRIVATE_KEY_PEM_PATH=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
MICROSOFT_AUTHORITY_HOST=https://login.microsoftonline.com
TEAMS_RECONCILE_INTERVAL_MS=300000
# Comma-separated tenantId:userId mailboxes for polling fallback
TEAMS_RECONCILE_MAILBOXES=

# --- Microsoft Graph (platform-backend actenora.microsoft-graph.*) ---
ACTENORA_MICROSOFT_GRAPH_ENABLED=false
ACTENORA_MICROSOFT_GRAPH_AUTH_MODE=CLIENT_SECRET
ACTENORA_MICROSOFT_GRAPH_TENANT_ID=
ACTENORA_MICROSOFT_GRAPH_CLIENT_ID=
ACTENORA_MICROSOFT_GRAPH_CLIENT_SECRET=
ACTENORA_MICROSOFT_GRAPH_CERTIFICATE_PEM_PATH=
ACTENORA_MICROSOFT_GRAPH_PRIVATE_KEY_PEM_PATH=
ACTENORA_MICROSOFT_GRAPH_CLIENT_STATE=local-graph-client-state
ACTENORA_MICROSOFT_GRAPH_WORKERS_ENABLED=true
ACTENORA_MICROSOFT_GRAPH_DEFAULT_MAILBOX_USER_ID=
ACTENORA_MICROSOFT_GRAPH_TRANSCRIPT_POLL_INTERVAL=PT5M
# Aliases (still accepted by Spring bindings):
# MICROSOFT_TENANT_ID / MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET / MICROSOFT_CERTIFICATE_*
# Graph sandbox: SPRING_PROFILES_ACTIVE=graph-sandbox,local + real Entra credentials (no demo seed)

# --- AI orchestrator (Python) ---
AI_ORCHESTRATOR_PORT=8000
AI_ORCHESTRATOR_HOST=127.0.0.1
# Platform NanobaseAI Intelligence (local endpoint only)
ACTENORA_AI_PROVIDER_KIND=nanobaseai
ACTENORA_AI_PROVIDER_BASE_URL=http://127.0.0.1:8000
ACTENORA_AI_PROVIDER_SERVED_MODEL_IDS=nanobaseai-primary,nanobaseai-local
ACTENORA_AI_WORKER_ENABLED=true
ACTENORA_AI_WORKER_POLL_INTERVAL=PT15S
# Leave empty for FAZ-2 degraded readiness; set when local NanobaseAI Intelligence is available.
NANOBASEAI_INTELLIGENCE_BASE_URL=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=actenora
POSTGRES_USER=actenora
POSTGRES_PASSWORD=actenora_local_change_me
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/actenora

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=actenora
RABBITMQ_PASSWORD=actenora_local_change_me
RABBITMQ_VHOST=/

# --- Redis (persistence optional for local) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PERSISTENCE=false

# --- Object storage (MinIO-compatible) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
OBJECT_STORAGE_ACCESS_KEY=actenora_minio
OBJECT_STORAGE_SECRET_KEY=actenora_minio_change_me
OBJECT_STORAGE_BUCKET=actenora
OBJECT_STORAGE_TENANT_PREFIX_ROOT=tenants
OBJECT_STORAGE_TEST_TENANT_ID=tenant-local-test
ACTENORA_OBJECT_STORAGE_ENABLED=true

# --- MailHog ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=actenora-local@example.test
MAIL_TO=developer@example.test

# --- Observability (OTLP → local collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=actenora
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
