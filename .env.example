# Actenora local development — copy to .env and adjust.
# Never commit real secrets.
# Default credentials are for ACTENORA_ENV=local / SPRING_PROFILES_ACTIVE=local ONLY.
# Production (SPRING_PROFILES_ACTIVE=prod) refuses *_change_me / actenora_local secrets.

# --- Runtime ---
ACTENORA_ENV=local
LOG_LEVEL=INFO

# --- Platform backend (Java) ---
PLATFORM_BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Web portal (Node) ---
WEB_PORTAL_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# --- Teams meeting app (Node) ---
TEAMS_APP_PORT=3978

# --- Teams integration service (FAZ 21, separately scalable) ---
TEAMS_INTEGRATION_PORT=8085
# CERTIFICATE = production; CLIENT_SECRET = local/test only
MICROSOFT_GRAPH_AUTH_MODE=CLIENT_SECRET
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CERTIFICATE_PEM_PATH=
MICROSOFT_PRIVATE_KEY_PEM_PATH=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
MICROSOFT_AUTHORITY_HOST=https://login.microsoftonline.com
TEAMS_RECONCILE_INTERVAL_MS=300000
# Comma-separated tenantId:userId mailboxes for polling fallback
TEAMS_RECONCILE_MAILBOXES=

# --- AI orchestrator (Python) ---
AI_ORCHESTRATOR_PORT=8000
AI_ORCHESTRATOR_HOST=127.0.0.1
# Leave empty for FAZ-2 degraded readiness; set when a local Qwen/Ollama endpoint exists.
QWEN_BASE_URL=
LLM_BASE_URL=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=actenora
POSTGRES_USER=actenora
POSTGRES_PASSWORD=actenora_local_change_me
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/actenora

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=actenora
RABBITMQ_PASSWORD=actenora_local_change_me
RABBITMQ_VHOST=/

# --- Redis (persistence optional for local) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PERSISTENCE=false

# --- Object storage (MinIO-compatible) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
OBJECT_STORAGE_ACCESS_KEY=actenora_minio
OBJECT_STORAGE_SECRET_KEY=actenora_minio_change_me
OBJECT_STORAGE_BUCKET=actenora
OBJECT_STORAGE_TENANT_PREFIX_ROOT=tenants
OBJECT_STORAGE_TEST_TENANT_ID=tenant-local-test

# --- MailHog ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=actenora-local@example.test
MAIL_TO=developer@example.test

# --- Observability (OTLP → local collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=actenora
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
