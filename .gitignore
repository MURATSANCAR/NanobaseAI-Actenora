.claude/settings.local.json

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/
.DS_Store

# Env / secrets — never commit
.env
.env.local
.env.*.local
.env.production
.env.staging
!.env.example
!.env.*.example
secrets/
*.pem
*.p12
*.jks
*.keystore
credentials.json
service-account*.json
*.secret

